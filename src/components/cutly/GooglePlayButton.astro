---
import { Icon } from 'astro-icon/components';
import type { en } from '../../i18n/en';

interface Props {
  content: typeof en;
}

const { content } = Astro.props;
const { googlePlay, links } = content;
---

<a
  href={links.googlePlay}
  target="_blank"
  rel="noopener noreferrer"
  class="flex items-center gap-2 px-8 py-3.5 rounded-full bg-gradient-to-r from-primary to-[#4CAF50] text-white font-bold text-lg shadow-[0_4px_15px_rgba(45,130,89,0.3)] hover:translate-y-[-2px] hover:shadow-[0_6px_20px_rgba(45,130,89,0.4)] transition-all duration-200 cursor-pointer"
>
  <Icon name="fa6-brands:google-play" class="text-xl" />
  {googlePlay}
</a>
