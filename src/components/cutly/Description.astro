---
import type { en } from '../../i18n/en';

interface Props {
  content: typeof en;
}

const { content } = Astro.props;
---

<section class="section">
  <p class="text-xl md:text-[1.25rem] text-center max-w-[900px] mx-auto leading-relaxed md:leading-[1.8] text-text-secondary md:text-center">
    {content.description}
  </p>
</section>

<style>
  .section {
    padding: 80px 20px;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media (max-width: 768px) {
    .section {
      padding: 40px 20px;
      gap: 30px;
    }
  }
</style>
