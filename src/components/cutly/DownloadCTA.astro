---
import SectionTitle from './SectionTitle.astro';
import GooglePlayButton from './GooglePlayButton.astro';
import type { en } from '../../i18n/en';

interface Props {
  content: typeof en;
}

const { content } = Astro.props;
---

<section class="py-20 px-5 text-center flex flex-col items-center gap-8 bg-background-secondary/30">
  <SectionTitle>{content.downloadTitle}</SectionTitle>
  <GooglePlayButton content={content} />
</section>
