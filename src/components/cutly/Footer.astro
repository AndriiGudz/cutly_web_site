---
import { Icon } from 'astro-icon/components';
import type { en } from '../../i18n/en';

interface Props {
  content: typeof en;
}

const { content } = Astro.props;
---

<footer class="bg-primary-dark text-white py-15 px-5 text-center">
  <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-10">
    <div class="flex flex-col gap-6 items-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white relative inline-block after:content-[''] after:absolute after:w-20 after:h-1 after:bg-gradient-to-r after:from-primary after:to-[#4CAF50] after:-bottom-2.5 after:left-1/2 after:-translate-x-1/2 after:rounded-sm">
        {content.developerTitle}
      </h2>
      
      <p class="text-[rgba(255,255,255,0.8)] max-w-[600px] mx-auto text-base leading-relaxed">
        {content.developerText}
      </p>
    </div>

    <div class="mt-4 flex flex-col gap-4 items-center">
      <p class="text-[rgba(255,255,255,0.9)] text-lg">
        {content.socialTitle}
      </p>
      <div class="flex gap-6">
        <a href={content.links.telegram} target="_blank" class="text-white hover:text-primary-light transition-colors duration-300">
          <Icon name="fa6-brands:telegram" class="text-3xl" />
        </a>
        <a href={content.links.instagram} target="_blank" class="text-white hover:text-primary-light transition-colors duration-300">
          <Icon name="fa6-brands:instagram" class="text-3xl" />
        </a>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-6 items-center">
      <div class="flex flex-wrap justify-center items-center gap-8">
        <a href={content.links.website} target="_blank" class="flex items-center gap-2 text-primary-light no-underline hover:underline">
          <Icon name="fa6-solid:globe" /> gudz-andrii.com
        </a>
        <a href={content.links.email} class="flex items-center gap-2 text-primary-light no-underline hover:underline">
          <Icon name="fa6-solid:envelope" /> andriigudz.de@gmail.com
        </a>
      </div>
      
      <p class="text-[rgba(255,255,255,0.6)] text-sm">
        {content.copyright}
      </p>
    </div>
  </div>
</footer>
