---
import { Icon } from 'astro-icon/components';
import { content } from '../../data/content';
import SectionTitle from './SectionTitle.astro';
---

<section class="max-w-[1200px] mx-auto px-5 py-10 md:py-20 flex flex-col gap-10">
  <SectionTitle>{content.audienceTitle}</SectionTitle>
  
  <div class="flex flex-col gap-4">
    {content.audience.map((item) => (
      <div class="flex flex-col md:flex-row items-center gap-4 bg-surface p-5 md:p-6 rounded-2xl shadow-[0_4px_10px_rgba(0,0,0,0.03)] text-center md:text-left">
        <div class="w-14 h-14 rounded-2xl bg-secondary-bg flex items-center justify-center text-primary text-2xl shrink-0">
          <Icon name={item.icon} />
        </div>
        <p class="text-base text-text-secondary leading-relaxed m-0">{item.text}</p>
      </div>
    ))}
  </div>
</section>
