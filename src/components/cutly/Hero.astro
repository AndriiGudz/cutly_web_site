---
import { Icon } from 'astro-icon/components';
import GooglePlayButton from './GooglePlayButton.astro';
import type { en } from '../../i18n/en';

interface Props {
  content: typeof en;
}

const { content } = Astro.props;
const { subtitle, logoAlt } = content;
---

<section class="flex min-h-[80vh] flex-col items-center justify-center pt-24 md:pt-35 pb-20 px-5 text-center gap-10">
  <img
    src="/images/logo_cutly.png"
    alt={logoAlt}
    class="w-[200px] md:w-[350px] mb-2 animate-fade-in-up"
  />
  
  <p class="text-lg md:text-xl text-text-secondary max-w-[600px] leading-relaxed mb-8 animate-fade-in-up delay-100">
    {subtitle}
  </p>
  
  <div class="flex gap-4 flex-wrap justify-center animate-fade-in-up delay-200">
    <GooglePlayButton content={content} />
  </div>
</section>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
    transform: translateY(30px);
  }
  
  .delay-100 {
    animation-delay: 0.1s;
  }
  
  .delay-200 {
    animation-delay: 0.2s;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
